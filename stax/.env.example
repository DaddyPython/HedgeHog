# --- Phase 0 (measurement): no configuration required. Defaults below. ---

# Where JSONL archives are written
STAX_DATA_DIR=data

# RSS poll interval in seconds (lower = tighter first-seen timestamps, more load)
STAX_NEWS_POLL_SECONDS=15

# --- Phase 2/3 (execution): leave unset until every gate in docs/PLAN.md passes ---

# Must be exactly this string to allow any live order:
# STAX_LIVE_TRADING=I_UNDERSTAND_THE_RISKS

# Polygon wallet private key used by py-clob-client (never commit a real key)
# STAX_POLYGON_PRIVATE_KEY=

# Risk caps (USDC)
STAX_MAX_TRADE_NOTIONAL=25
STAX_MAX_MARKET_EXPOSURE=50
STAX_MAX_DAILY_LOSS=100
STAX_MAX_OPEN_POSITIONS=5
